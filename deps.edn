{:paths ["src"]
 ;; Public coordinates only. A machine-local :local/root override for the sibling
 ;; engine checkout belongs in local.deps.edn (gitignored) — never a host path here.
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        ;; The engine pins these as GIT coords and hive-system as MVN; tools.deps
        ;; cannot compare the two forms, so they are fixed here at top level —
        ;; a top-level declaration beats every transitive.
        io.github.hive-agi/hive-dsl    {:mvn/version "0.5.8"}
        io.github.hive-agi/hive-events {:mvn/version "0.5.6"}
        io.github.hive-agi/hive-weave  {:mvn/version "0.2.9"}
        ;; IPathQuery + IFilesystem — path questions and filesystem mutations
        ;; go through hive-system, never raw java.io.
        io.github.hive-agi/hive-system {:mvn/version "0.3.1"}
        io.github.buddhilw/vtranslate-engine {:mvn/version "0.1.1"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :main-opts ["-m" "kaocha.runner"]}

  :test-repl {:extra-paths ["test"]
              :extra-deps {nrepl/nrepl            {:mvn/version "1.7.0"}
                           cider/cider-nrepl      {:mvn/version "0.58.0"}
                           lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                           org.clojure/test.check {:mvn/version "1.1.1"}}
              :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
                 slipset/deps-deploy           {:mvn/version "0.2.2"}}
          :ns-default build}}}

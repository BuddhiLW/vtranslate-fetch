{:paths ["src"]
 ;; Public coordinates only. A machine-local :local/root override for the sibling
 ;; engine checkout belongs in local.deps.edn (gitignored) — never a host path here.
 ;; hive-system and vtranslate-engine are required by src (adapters/ytdlp.clj and
 ;; providers/register.clj), so they are base dependencies, not alias ones: an AOT
 ;; publish compiles those namespaces, and a consumer of the pom needs them
 ;; declared. Both resolve from Clojars.
 :deps {org.clojure/clojure                 {:mvn/version "1.12.5"}
        io.github.hive-agi/hive-dsl         {:mvn/version "0.5.19"}
        io.github.hive-agi/hive-system      {:mvn/version "0.3.8"}
        io.github.buddhilw/vtranslate-engine {:mvn/version "0.1.2"}}

 :aliases
 {:engine
  {:extra-deps
   {io.github.hive-agi/hive-events          {:mvn/version "0.5.9"}
    io.github.hive-agi/hive-weave           {:mvn/version "0.3.4"}
    io.github.hive-agi/hive-system          {:mvn/version "0.3.8"}
    io.github.buddhilw/vtranslate-engine    {:mvn/version "0.1.2"}}}

  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-events       {:mvn/version "0.5.9"}
                      io.github.hive-agi/hive-weave        {:mvn/version "0.3.4"}
                      io.github.hive-agi/hive-system       {:mvn/version "0.3.8"}
                      io.github.buddhilw/vtranslate-engine {:mvn/version "0.1.2"}}
         :main-opts ["-m" "kaocha.runner"]}

  :test-repl {:extra-paths ["test"]
              :extra-deps {nrepl/nrepl            {:mvn/version "1.7.0"}
                           cider/cider-nrepl      {:mvn/version "0.62.2"}
                           lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                           org.clojure/test.check {:mvn/version "1.1.3"}
                           io.github.hive-agi/hive-events       {:mvn/version "0.5.9"}
                           io.github.hive-agi/hive-weave        {:mvn/version "0.3.4"}
                           io.github.hive-agi/hive-system       {:mvn/version "0.3.8"}
                           io.github.buddhilw/vtranslate-engine {:mvn/version "0.1.2"}}
              :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy           {:mvn/version "0.2.5"}}
          :ns-default build}}}

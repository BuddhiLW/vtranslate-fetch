{:paths ["src"]
 ;; Public coordinates only. A machine-local :local/root override for the sibling
 ;; engine checkout belongs in local.deps.edn (gitignored) — never a host path here.
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        io.github.hive-agi/hive-dsl {:git/tag "v0.5.1" :git/sha "335869e"}
        ;; IPathQuery — path existence/kind questions go through hive-system,
        ;; never raw java.io predicates.
        io.github.hive-agi/hive-system {:git/tag "v0.2.4" :git/sha "0706c57"}
        io.github.BuddhiLW/vtranslate-engine
        {:git/url "https://github.com/BuddhiLW/vtranslate-engine"
         :git/sha "6d4427389f775439dbfccb99d051a970732c6b3f"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :main-opts ["-m" "kaocha.runner"]}

  :test-repl {:extra-paths ["test"]
              :extra-deps {nrepl/nrepl            {:mvn/version "1.7.0"}
                           cider/cider-nrepl      {:mvn/version "0.58.0"}
                           lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                           org.clojure/test.check {:mvn/version "1.1.1"}}
              :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}}}
